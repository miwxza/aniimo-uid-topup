# --- Copy to .env and adjust. All vars are prefixed ANIIMO_. ---

# Role/UID verification backend: mock | session | partner
ANIIMO_ROLE_PROVIDER=mock

# Region lock (TWD / Taiwan / MyCard). To actually receive TWD pricing and the
# MyCard channel from upstream, egress from a Taiwan IP:
# ANIIMO_OUTBOUND_PROXY=http://user:pass@tw-proxy.example.com:8080

# --- partner provider ---
# ANIIMO_PARTNER_VERIFY_URL=https://partner.example.com/aniimo/role/lookup
# ANIIMO_PARTNER_API_KEY=changeme

# --- session provider ---
# Store-account session cookie captured after an OTP login with the dev account.
# ANIIMO_ACCOUNT_SESSION_COOKIE=session_key=...; other=...

# --- resilience ---
ANIIMO_RATE_LIMIT_PER_MIN=30
ANIIMO_RATE_LIMIT_BURST=10
ANIIMO_ENV=dev
