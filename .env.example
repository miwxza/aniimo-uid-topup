# --- Copy to .env and adjust. All vars are prefixed ANIIMO_. ---

# Role/UID verification backend: mock | session | partner
ANIIMO_ROLE_PROVIDER=mock

# Region lock (TWD / Taiwan / MyCard). To actually receive TWD pricing and the
# MyCard channel from upstream, egress from a Taiwan IP:
# ANIIMO_OUTBOUND_PROXY=http://user:pass@tw-proxy.example.com:8080

# --- partner provider ---
# ANIIMO_PARTNER_VERIFY_URL=https://partner.example.com/aniimo/role/lookup
# ANIIMO_PARTNER_API_KEY=changeme

# --- session provider ---
# Store-account session cookie captured after an OTP login with the dev account.
# ANIIMO_ACCOUNT_SESSION_COOKIE=session_key=...; other=...

# --- resilience ---
ANIIMO_RATE_LIMIT_PER_MIN=30
ANIIMO_RATE_LIMIT_BURST=10
# Trust X-Forwarded-For only when the direct peer is one of these proxies
# (JSON list). Leave empty behind no proxy so the header can't be spoofed.
# ANIIMO_TRUSTED_PROXIES=["127.0.0.1"]
# Order placement never auto-retries on an ambiguous failure; this only covers
# failures that provably never reached the server.
ANIIMO_ORDER_CONNECT_RETRIES=0

# Idempotency/dedupe state: memory (dev/tests) or sqlite (survives restart).
# Use Redis in a cluster. 'unknown'/'in_flight' entries never TTL-expire.
ANIIMO_IDEMPOTENCY_BACKEND=memory
# ANIIMO_IDEMPOTENCY_DB_PATH=order_state.db

# env=prod refuses role_provider=mock (fails at startup).
ANIIMO_ENV=dev
